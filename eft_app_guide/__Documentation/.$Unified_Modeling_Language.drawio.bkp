        <mxCell id="O0yBeKbIqRbkFnmsTAuP-18" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;Compositon&lt;/font&gt;" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=20;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
