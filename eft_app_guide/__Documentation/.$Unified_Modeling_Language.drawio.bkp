        <mxCell id="O0yBeKbIqRbkFnmsTAuP-26" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;A class is associated with another class. Multiplication can be noted.&lt;/span&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="O0yBeKbIqRbkFnmsTAuP-25">
