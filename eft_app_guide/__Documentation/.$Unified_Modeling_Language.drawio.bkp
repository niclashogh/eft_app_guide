        </mxCell>
        <mxCell id="O0yBeKbIqRbkFnmsTAuP-19" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;A class contains or is dependent on another class to be able to exist.&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;" vertex="1" parent="O0yBeKbIqRbkFnmsTAuP-18">
